config_version=5

[application]
config/name="Mistpaw — 霧爪"
config/version="0.1.1"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.025,0.05,0.06,1)
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect.web="expand"

[rendering]
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.web=0
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.08, 0.13, 0.14, 1)

rendering_device/driver.macos="metal"

[audio]
general/default_playback_type.web=1

[gui]
theme/custom_font.web="res://assets/fonts/NotoSansTC-Regular.ttf"
